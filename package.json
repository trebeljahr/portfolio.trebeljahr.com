{
  "name": "portfolio-page",
  "version": "1.0.0",
  "authors": [
    "Rico Trebeljahr"
  ],
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "framer-motion": "^11.0.0",
    "next": "^16.3.3",
    "react": "^19.2.6",
    "react-countup": "^6.5.0",
    "react-dom": "^19.2.6",
    "react-icons": "^5.4.0",
    "react-toastify": "^11.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@next/bundle-analyzer": "^16.2.6",
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "lint": "biome lint .",
    "dev": "next dev --webpack --hostname localhost --port 3801",
    "build": "next build --webpack",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "generateExports": "ts-node-esm ./scripts/codeGenExports.mts",
    "seo:generate": "node scripts/generate-seo.mjs",
    "prebuild": "node scripts/generate-seo.mjs",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "pnpm": {
    "overrides": {
      "serialize-javascript": "7.0.5",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "picomatch@2": "2.3.2",
      "lodash@4": "4.18.1",
      "postcss@8": "8.5.28",
      "@babel/plugin-transform-modules-systemjs@7": "7.29.4",
      "@babel/core@7": "7.29.6",
      "fast-uri@3": "3.1.8",
      "nanoid@3": "3.3.18",
      "browserslist@4": "4.28.7",
      "baseline-browser-mapping@2": "2.11.0",
      "ws@7": "7.5.11",
      "postcss-selector-parser@6": "6.1.3"
    }
  }
}
