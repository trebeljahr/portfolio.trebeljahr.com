{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "components/*": ["./components/*"]
    },
    "target": "es2015",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true
  },
  "ts-node": {
    "compilerOptions": {
      "target": "esnext"
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "**/*.mts"],
  // workers/ is a separate deployment target with its own tsconfig and
  // Worker-runtime types. Type-checking it as part of the site build fails on
  // globals the browser/Node libs do not declare.
  "exclude": ["node_modules", "workers"]
}
