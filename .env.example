# Copy to .env.local for development. Every NEXT_PUBLIC_* value is inlined into
# the static export at build time, so changing one needs a rebuild and redeploy.

# Endpoint of the shared forms Worker that handles the contact form.
# The site is a static export and has no API routes, so this must be an
# absolute URL. Defaults to the deployed Worker when unset — override it to
# test against a local `wrangler dev` or a different deployment.
# See workers/forms/README.md.
NEXT_PUBLIC_CONTACT_ENDPOINT=https://forms-api.ricoslabs.workers.dev/contact
